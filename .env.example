# Desarrollo local: npm run dev carga .env.local automáticamente.
# Con PostgreSQL del sistema, normalmente basta esta URL sin contraseña.
DATABASE_URL=postgresql://localhost/burning_bull
# Alternativa Docker opcional: docker compose up -d db
# DATABASE_URL=postgresql://burning_bull:burning_bull_dev@127.0.0.1:5433/burning_bull

DEV_PORT=5173
DEV_API_PORT=3000
LOCAL_ADMIN_EMAIL=gerencia@burningbull.local

# Para comandos independientes como dev:api y db:bootstrap.
# npm run dev establece el origen/puerto elegidos y NODE_ENV=development.
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3000

# Producción usa configuración privada del servicio; no copiarla aquí.
# BOOTSTRAP_MANAGER_EMAIL=
# BOOTSTRAP_MANAGER_NAME=
# BOOTSTRAP_INVITE_TOKEN=
